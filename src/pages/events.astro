---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
const currentPath = "/events";

const event = {
  title: "Beeswax Lip and Hand Balm Workshop",
  dateLabel: "Saturday, December 5, 2026",
  timeLabel: "2 pm \u2013 4 pm",
  venue: "Carrot Common",
  address: "348 Danforth Ave, Room 212",
  directions: "The door for Room 212 is on the west side of Book City.",
  price: "$25 per person",
  takeHome: "Two lip balms and one hand balm",
  registerUrl: "https://bit.ly/4iwKLMg",
  email: "torontobeekeeperscollective@gmail.com",
};

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  "Carrot Common, 348 Danforth Ave, Toronto, ON"
)}`;

// 2 pm to 4 pm EST on Dec 5, 2026 (UTC-5)
const calendarUrl =
  "https://calendar.google.com/calendar/render?" +
  new URLSearchParams({
    action: "TEMPLATE",
    text: event.title,
    dates: "20261205T190000Z/20261205T210000Z",
    location: `${event.venue}, ${event.address}, Toronto, ON`,
    details: `${event.directions} Register: ${event.registerUrl}`,
  }).toString();

const posterAlt =
  "Poster for the Toronto Beekeepers Collective beeswax lip and hand balm workshop. " +
  "Great for gifts! Take home two lip balms and one hand balm. " +
  "Carrot Common, 348 Danforth, Room 212. Saturday, December 5, 2026, 2 pm to 4 pm. " +
  "$25 per person. Register by QR code or email torontobeekeeperscollective@gmail.com.";
---

<Base
  title="Events"
  description={`${event.title}: ${event.dateLabel}, ${event.timeLabel} at ${event.venue}, ${event.address}. ${event.price}. Take home two lip balms and one hand balm.`}
  ogImage="https://torontobeekeeping.ca/lip-balm-workshop-og.jpg"
>
  <Nav slot="nav" currentPath={currentPath} />

  <div class="page-header">
    <div class="container page-header-content">
      <h1>Events</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="workshop">
        <a class="workshop-poster" href="/lip-balm-workshop-poster.webp" aria-label="Open the poster full size">
          <img
            src="/lip-balm-workshop-poster.webp"
            alt={posterAlt}
            width="1122"
            height="1402"
            loading="eager"
          />
        </a>

        <div class="workshop-info">
          <p class="workshop-kicker">Upcoming workshop</p>
          <h2>{event.title}</h2>
          <p class="workshop-lede">
            Make beeswax balms with the club and take them home. Great for gifts.
          </p>

          <dl class="workshop-facts">
            <div>
              <dt>When</dt>
              <dd>
                <strong>{event.dateLabel}</strong><br />
                {event.timeLabel}
              </dd>
            </div>
            <div>
              <dt>Where</dt>
              <dd>
                <strong>{event.venue}</strong><br />
                {event.address}<br />
                <span class="workshop-note">{event.directions}</span>
              </dd>
            </div>
            <div>
              <dt>Cost</dt>
              <dd><strong>{event.price}</strong></dd>
            </div>
            <div>
              <dt>You take home</dt>
              <dd>{event.takeHome}</dd>
            </div>
          </dl>

          <div class="workshop-actions">
            <a class="btn btn-primary" href={event.registerUrl} target="_blank" rel="noopener">
              Register
            </a>
            <a class="btn btn-outline-dark" href={calendarUrl} target="_blank" rel="noopener">
              Add to calendar
            </a>
            <a class="btn btn-outline-dark" href={mapsUrl} target="_blank" rel="noopener">
              Get directions
            </a>
          </div>

          <p class="workshop-email">
            Prefer email? Write to
            <a href={`mailto:${event.email}?subject=${encodeURIComponent("Lip and hand balm workshop")}`}>{event.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .workshop {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .workshop-poster {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    line-height: 0;
  }
  .workshop-poster img {
    width: 100%;
    height: auto;
  }

  .workshop-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber-dark);
  }
  .workshop-info h2 {
    margin: 0 0 0.5rem;
  }
  .workshop-lede {
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }

  .workshop-facts {
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .workshop-facts > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
  }
  .workshop-facts > div:first-child {
    border-top: 0;
  }
  .workshop-facts dt {
    font-weight: 700;
    color: var(--amber-dark);
  }
  .workshop-facts dd {
    margin: 0;
    line-height: 1.5;
  }
  .workshop-note {
    font-size: 0.92rem;
    color: var(--charcoal-mid);
  }

  .workshop-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .workshop-email {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .workshop {
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .workshop-facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .workshop-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
