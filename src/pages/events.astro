---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { event } from "../lib/event.mjs";
const currentPath = "/events";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.mapsQuery)}`;

const gcalTime = (iso: string) => iso.replace(/[-:]/g, "").replace(/\.\d+/, "");
const calendarUrl =
  "https://calendar.google.com/calendar/render?" +
  new URLSearchParams({
    action: "TEMPLATE",
    text: event.title,
    dates: `${gcalTime(event.start)}/${gcalTime(event.end)}`,
    location: `${event.venue}, ${event.address}, Toronto, ON`,
    details: `${event.directions} Register: ${event.registerUrl}`,
  }).toString();
---

<Base
  title="Events"
  description={`${event.title}: ${event.dateLabel}, ${event.timeLabel} at ${event.venue}, ${event.address}. ${event.price}. ${event.description}`}
  ogImage={event.poster.ogSrc}
>
  <Nav slot="nav" currentPath={currentPath} />

  <div class="page-header">
    <div class="container page-header-content">
      <h1>Events</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="event">
        <a class="event-poster" href={event.poster.src} aria-label="Open the poster full size">
          <img
            src={event.poster.src}
            alt={event.poster.alt}
            width={event.poster.width}
            height={event.poster.height}
            loading="eager"
          />
        </a>

        <div class="event-info">
          <p class="event-kicker">Upcoming {event.kind}</p>
          <h2>{event.title}</h2>
          <p class="event-lede">{event.blurb}</p>

          <dl class="event-facts">
            <div>
              <dt>When</dt>
              <dd>
                <strong>{event.dateLabel}</strong><br />
                {event.timeLabel}
              </dd>
            </div>
            <div>
              <dt>Where</dt>
              <dd>
                <strong>{event.venue}</strong><br />
                {event.address}<br />
                <span class="event-note">{event.directions}</span>
              </dd>
            </div>
            <div>
              <dt>Cost</dt>
              <dd><strong>{event.price}</strong></dd>
            </div>
            {event.extras.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>

          <div class="event-actions">
            <a class="btn btn-primary" href={event.registerUrl} target="_blank" rel="noopener">
              Register
            </a>
            <a class="btn btn-outline-dark" href={calendarUrl} target="_blank" rel="noopener">
              Add to calendar
            </a>
            <a class="btn btn-outline-dark" href={mapsUrl} target="_blank" rel="noopener">
              Get directions
            </a>
          </div>

          <p class="event-email">
            Prefer email? Write to
            <a href={`mailto:${event.email}?subject=${encodeURIComponent(event.emailSubject)}`}>{event.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .event {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .event-poster {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    line-height: 0;
  }
  .event-poster img {
    width: 100%;
    height: auto;
  }

  .event-kicker {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber-dark);
  }
  .event-info h2 {
    margin: 0 0 0.5rem;
  }
  .event-lede {
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }

  .event-facts {
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    gap: 0;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .event-facts > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border);
  }
  .event-facts > div:first-child {
    border-top: 0;
  }
  .event-facts dt {
    font-weight: 700;
    color: var(--amber-dark);
  }
  .event-facts dd {
    margin: 0;
    line-height: 1.5;
  }
  .event-note {
    font-size: 0.92rem;
    color: var(--charcoal-mid);
  }

  .event-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .event-email {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .event {
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .event-facts > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .event-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
