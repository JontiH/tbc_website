---
export interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

// Update these for each event. The site rebuilds nightly, so the sticker
// disappears the first night after `hideAfter`.
const sticker = {
  href: "/events",
  kicker: "Upcoming",
  title: "Lip balm workshop",
  date: "Dec 5",
  hideAfter: new Date("2026-12-05T21:00:00Z"),
};

const show = currentPath.replace(/\/$/, "") !== sticker.href && new Date() < sticker.hideAfter;
---

{show && (
  <div class="event-sticker" id="event-sticker">
    <a class="event-sticker-link" href={sticker.href}>
      <span class="event-sticker-text">
        <span class="event-sticker-kicker">{sticker.kicker}</span>
        <span class="event-sticker-title">{sticker.title}</span>
        <span class="event-sticker-date">{sticker.date}</span>
      </span>
    </a>
    <button class="event-sticker-close" id="event-sticker-close" type="button" aria-label="Hide event notice">
      &times;
    </button>
  </div>

  <script is:inline>
    (function () {
      var el = document.getElementById("event-sticker");
      try {
        if (sessionStorage.getItem("tbc-sticker-hidden")) el.hidden = true;
      } catch (e) {}
      document.getElementById("event-sticker-close").addEventListener("click", function () {
        el.hidden = true;
        try {
          sessionStorage.setItem("tbc-sticker-hidden", "1");
        } catch (e) {}
      });
    })();
  </script>
)}

<style>
  /* Quarter circle in the top-left corner, over the nav. Absolute (not fixed)
     so it scrolls away with the page instead of covering content. */
  .event-sticker {
    --r: min(40vw, 36rem);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 120;
    width: var(--r);
    height: var(--r);
    transform-origin: top left;
    transition: transform 0.2s ease;
    filter: drop-shadow(0 4px 10px rgba(43, 43, 43, 0.3));
  }
  .event-sticker[hidden] {
    display: none;
  }
  .event-sticker:hover,
  .event-sticker:focus-within {
    transform: scale(1.03);
  }
  /* The mobile menu opens full width under the sticker. */
  :global(body:has(.nav-links.open)) .event-sticker {
    display: none;
  }

  .event-sticker-link {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 0 0 var(--r) 0;
    border-right: 6px solid #fff;
    border-bottom: 6px solid #fff;
    background: radial-gradient(circle at 0 0, #ffc857 0%, var(--amber) 75%);
    color: var(--charcoal);
    text-decoration: none;
  }
  .event-sticker-link:hover {
    text-decoration: none;
  }

  /* Text sits along the diagonal, rotated to follow the arc. */
  .event-sticker-text {
    position: absolute;
    left: calc(var(--r) * 0.4);
    top: calc(var(--r) * 0.4);
    width: calc(var(--r) * 0.6);
    transform: translate(-50%, -50%) rotate(-45deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--r) * 0.01);
    text-align: center;
  }
  .event-sticker-kicker {
    font-size: calc(var(--r) * 0.055);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .event-sticker-title {
    font-size: calc(var(--r) * 0.095);
    font-weight: 800;
    line-height: 1.1;
  }
  .event-sticker-date {
    margin-top: calc(var(--r) * 0.02);
    padding: 0.05em 0.7em;
    border-radius: 999px;
    background: var(--charcoal);
    color: #fff;
    font-size: calc(var(--r) * 0.07);
    font-weight: 700;
  }

  .event-sticker-close {
    position: absolute;
    left: calc(var(--r) * 0.88 - 1.1rem);
    top: calc(var(--r) * 0.26 - 1.1rem);
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--charcoal);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  /* Keep clear of the nav links, which start further left on narrow desktops. */
  @media (max-width: 1000px) {
    .event-sticker {
      --r: 27vw;
    }
  }
  /* Hamburger menu from here down, so the whole corner is free. */
  @media (max-width: 720px) {
    .event-sticker {
      --r: 80vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-sticker {
      transition: none;
    }
  }
</style>
