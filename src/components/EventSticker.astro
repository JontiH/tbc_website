---
export interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

// Update these for each event. The site rebuilds nightly, so the sticker
// disappears the first night after `hideAfter`.
const sticker = {
  href: "/events",
  kicker: "Upcoming event",
  title: "Lip balm workshop",
  date: "Dec 5",
  hideAfter: new Date("2026-12-05T21:00:00Z"),
};

const show = currentPath.replace(/\/$/, "") !== sticker.href && new Date() < sticker.hideAfter;
---

{show && (
  <div class="event-sticker" id="event-sticker">
    <a class="event-sticker-link" href={sticker.href}>
      <span class="event-sticker-kicker">{sticker.kicker}</span>
      <span class="event-sticker-title">{sticker.title}</span>
      <span class="event-sticker-date">{sticker.date}</span>
    </a>
    <button class="event-sticker-close" id="event-sticker-close" type="button" aria-label="Hide event notice">
      &times;
    </button>
  </div>

  <script is:inline>
    (function () {
      var el = document.getElementById("event-sticker");
      try {
        if (sessionStorage.getItem("tbc-sticker-hidden")) el.hidden = true;
      } catch (e) {}
      document.getElementById("event-sticker-close").addEventListener("click", function () {
        el.hidden = true;
        try {
          sessionStorage.setItem("tbc-sticker-hidden", "1");
        } catch (e) {}
      });
    })();
  </script>
)}

<style>
  .event-sticker {
    position: fixed;
    top: 84px;
    left: 8px;
    z-index: 90;
    transform: rotate(-8deg);
    transition: transform 0.2s ease;
  }
  .event-sticker[hidden] {
    display: none;
  }
  .event-sticker:hover,
  .event-sticker:focus-within {
    transform: rotate(0deg) scale(1.05);
  }

  .event-sticker-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 6.5rem;
    height: 6.5rem;
    padding: 0.5rem;
    border-radius: 50%;
    border: 4px solid #fff;
    background: radial-gradient(circle at 35% 30%, #ffc857 0%, var(--amber) 70%);
    color: var(--charcoal);
    text-align: center;
    text-decoration: none;
    box-shadow:
      0 0 0 1px rgba(43, 43, 43, 0.12),
      0 6px 16px rgba(43, 43, 43, 0.28);
  }
  .event-sticker-link:hover {
    text-decoration: none;
  }

  .event-sticker-kicker {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .event-sticker-title {
    font-size: 0.85rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .event-sticker-date {
    margin-top: 0.15rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--charcoal);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .event-sticker-close {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--charcoal);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .event-sticker {
      top: 80px;
      left: 4px;
    }
    .event-sticker-link {
      width: 5.75rem;
      height: 5.75rem;
      padding: 0.4rem;
    }
    .event-sticker-title {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-sticker {
      transition: none;
    }
  }
</style>
