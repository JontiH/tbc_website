---
export interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

// Update these for each event. The site rebuilds nightly, so the sticker
// disappears the first night after `hideAfter`.
const sticker = {
  href: "/events",
  kicker: "Upcoming",
  title: "Lip balm workshop",
  date: "Dec 5",
  hideAfter: new Date("2026-12-05T21:00:00Z"),
};

const show = currentPath.replace(/\/$/, "") !== sticker.href && new Date() < sticker.hideAfter;
---

{show && (
  <div class="event-sticker" id="event-sticker">
    <a class="event-sticker-link" href={sticker.href}>
      <span class="event-sticker-text">
        <span class="event-sticker-kicker">{sticker.kicker}</span>
        <span class="event-sticker-title">{sticker.title}</span>
        <span class="event-sticker-date">{sticker.date}</span>
      </span>
    </a>
    <button class="event-sticker-close" id="event-sticker-close" type="button" aria-label="Hide event notice">
      &times;
    </button>
  </div>

  <script is:inline>
    (function () {
      var el = document.getElementById("event-sticker");
      try {
        if (sessionStorage.getItem("tbc-sticker-hidden")) el.hidden = true;
      } catch (e) {}
      document.getElementById("event-sticker-close").addEventListener("click", function () {
        el.hidden = true;
        try {
          sessionStorage.setItem("tbc-sticker-hidden", "1");
        } catch (e) {}
      });
    })();
  </script>
)}

<style>
  /* Quarter circle pinned under the nav (70px bar + 3px border) at the left edge. */
  .event-sticker {
    --r: 10.5rem;
    position: fixed;
    top: 73px;
    left: 0;
    z-index: 90;
    width: var(--r);
    height: var(--r);
    transform-origin: top left;
    transition: transform 0.2s ease;
    filter: drop-shadow(0 4px 8px rgba(43, 43, 43, 0.3));
  }
  .event-sticker[hidden] {
    display: none;
  }
  .event-sticker:hover,
  .event-sticker:focus-within {
    transform: scale(1.05);
  }

  .event-sticker-link {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 0 0 var(--r) 0;
    border-right: 4px solid #fff;
    border-bottom: 4px solid #fff;
    background: radial-gradient(circle at 0 0, #ffc857 0%, var(--amber) 75%);
    color: var(--charcoal);
    text-decoration: none;
  }
  .event-sticker-link:hover {
    text-decoration: none;
  }

  /* Text sits along the diagonal, rotated to follow the arc. */
  .event-sticker-text {
    position: absolute;
    left: calc(var(--r) * 0.4);
    top: calc(var(--r) * 0.4);
    width: calc(var(--r) * 0.6);
    transform: translate(-50%, -50%) rotate(-45deg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    text-align: center;
  }
  .event-sticker-kicker {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .event-sticker-title {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .event-sticker-date {
    margin-top: 0.2rem;
    padding: 0.05rem 0.6rem;
    border-radius: 999px;
    background: var(--charcoal);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .event-sticker-close {
    position: absolute;
    left: calc(var(--r) * 0.88 - 0.75rem);
    top: calc(var(--r) * 0.26 - 0.75rem);
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--charcoal);
    color: #fff;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .event-sticker {
      --r: 8.5rem;
    }
    .event-sticker-title {
      font-size: 0.9rem;
    }
    .event-sticker-date {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-sticker {
      transition: none;
    }
  }
</style>
