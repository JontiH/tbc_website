---
export interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

// Update these for each event. The site rebuilds nightly, so the sticker
// disappears the first night after `hideAfter`.
const sticker = {
  id: "lip-balm-2026",
  href: "/events",
  kicker: "Upcoming",
  title: "Lip balm workshop",
  date: "Dec 5",
  hideAfter: new Date("2026-12-05T21:00:00Z"),
};

const path = currentPath.replace(/\/$/, "") || "/";
const show = path !== sticker.href && new Date() < sticker.hideAfter;

// Distance from the top of the page to the first heading (hero h1 on the home
// page, page-header h1 elsewhere). The arc is sized to stop just short of it.
const headingTop = path === "/" ? 204 : 121;
---

{show && (
  <>
    {/* Runs before the sticker is parsed so a dismissed sticker never paints. */}
    <script is:inline define:vars={{ key: `tbc-sticker-${sticker.id}` }}>
      try {
        if (sessionStorage.getItem(key)) document.documentElement.classList.add("sticker-dismissed");
      } catch (e) {}
    </script>
    <div class="event-sticker" id="event-sticker" style={`--heading-top: ${headingTop}px`}>
      <a class="event-sticker-link" href={sticker.href}>
        <span class="event-sticker-text">
          <span class="event-sticker-kicker">{sticker.kicker}</span>
          <span class="event-sticker-title">{sticker.title}</span>
          <span class="event-sticker-date">{sticker.date}</span>
        </span>
      </a>
      <button class="event-sticker-close" id="event-sticker-close" type="button" aria-label="Hide event notice">
        &times;
      </button>
    </div>
    <script is:inline define:vars={{ key: `tbc-sticker-${sticker.id}` }}>
      document.getElementById("event-sticker-close").addEventListener("click", function () {
        document.documentElement.classList.add("sticker-dismissed");
        try {
          sessionStorage.setItem(key, "1");
        } catch (e) {}
      });
    </script>
  </>
)}

<style>
  /* Quarter circle in the top-left corner, over the nav. Absolute (not fixed)
     so it scrolls away with the page instead of covering content. */
  .event-sticker {
    --r: 11rem;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 120;
    width: var(--r);
    height: var(--r);
    filter: drop-shadow(0 4px 10px rgba(43, 43, 43, 0.3));
  }
  /* The arc reaches the left edge of the page content (the line the hero tag
     and headings start on), which is max(1.5rem, 50vw - 526px) from the left.
     Below 11rem the text would not fit, so that is the floor; the hypot term
     keeps the arc clear of the first heading when the floor applies. */
  @supports (width: hypot(1px, 1px)) {
    .event-sticker {
      --content-left: max(1.5rem, calc(50vw - 526px));
      --r: min(
        max(var(--content-left), 11rem),
        calc(hypot(var(--content-left), var(--heading-top)) - 10px),
        30rem
      );
    }
  }
  :global(html.sticker-dismissed) .event-sticker {
    display: none;
  }
  /* The mobile menu opens full width under the sticker. */
  :global(body:has(.nav-links.open)) .event-sticker {
    display: none;
  }

  .event-sticker-link {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 0 0 var(--r) 0;
    border-right: 5px solid #fff;
    border-bottom: 5px solid #fff;
    background: radial-gradient(circle at 0 0, #ffc857 0%, var(--amber) 75%);
    color: var(--charcoal);
    text-decoration: none;
  }
  .event-sticker-link:hover {
    text-decoration: none;
    filter: brightness(1.05);
  }

  /* Horizontal lines, each narrower than the arc is at that depth. */
  .event-sticker-text {
    position: absolute;
    left: calc(var(--r) * 0.08);
    top: calc(var(--r) * 0.1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(var(--r) * 0.02);
  }
  .event-sticker-kicker {
    font-size: calc(var(--r) * 0.07);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .event-sticker-title {
    max-width: 6.2em;
    font-size: calc(var(--r) * 0.13);
    font-weight: 800;
    line-height: 1.05;
  }
  .event-sticker-date {
    padding: 0.1em 0.7em;
    border-radius: 999px;
    background: var(--charcoal);
    color: #fff;
    font-size: calc(var(--r) * 0.09);
    font-weight: 700;
  }

  .event-sticker-close {
    position: absolute;
    left: calc(var(--r) * 0.84 - 0.8rem);
    top: calc(var(--r) * 0.3 - 0.8rem);
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--charcoal);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
