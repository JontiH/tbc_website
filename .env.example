# Copy this to .env and fill in values for local development.
# NEVER commit .env to git.

# Base URL of the deployed Cloudflare Worker. The Worker is fronted by
# Cloudflare Access on api.torontobeekeeping.ca; for local Astro dev pointed
# at the production API, leave this as-is and the browser will use the
# member's existing CF Access session.
HIVE_WORKER_URL=https://api.torontobeekeeping.ca

# When running both Astro and the Worker locally via docker-compose, the
# Astro container talks to the Worker at http://localhost:8787 instead.
# That's set directly in docker-compose.yml.

# ── Optional: required only when scripting against Access-protected URLs ─
# (e.g. the sync-access-policy workflow, or curl from the CLI).
# Get from: Zero Trust → Access → Service Auth → Service Tokens
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
