# Copy this to .env and fill in values for local development.
# NEVER commit .env to git.

# ── HIVE_WORKER_URL ─────────────────────────────────────────────────────
# Optional base URL for the Worker. In production, the Astro pages leave
# this unset and use relative /api/... paths (same origin as the site —
# torontobeekeeping.ca/api/*). Set this only if you need to point local
# Astro dev at a remote Worker; e.g.:
#   HIVE_WORKER_URL=https://torontobeekeeping.ca   (pages append /api/...)
# When running both Astro and the Worker locally via docker-compose, the
# Astro container talks to the Worker at http://localhost:8787 — set
# directly in docker-compose.yml.
# HIVE_WORKER_URL=

# ── Optional: required only when scripting against Access-protected URLs ─
# (e.g. the sync-access-policy workflow, or curl from the CLI).
# Get from: Zero Trust → Access → Service Auth → Service Tokens
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# ── Optional: Cloudflare API token (for ad-hoc API/config changes) ──────
# Needed by some maintenance scripts; not used at build/deploy time.
# CLOUDFLARE_API_TOKEN=
